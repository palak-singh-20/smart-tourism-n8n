        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert travel planner. You help travelers choose destinations based on their budget, interests, group size, trip duration, accommodation, transportation, and travel date.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Traveler details:\\nBudget: ₹{{ $json.budget }}\\nNumber of travelers: {{ $json.travelers }}\\nTrip duration: {{ $json.travel_duration }} days\\nTravel interests: {{ $json.interests }}\\nAccommodation preference: {{ $json.accommodation }}\\nTransportation preference: {{ $json.transportation }}\\nTravel date: {{ $json.travel_date }}\\n\\nRecommend exactly 3 suitable destinations. For each destination provide:\\n1. Destination name\\n2. Estimated total trip cost\\n3. Why it matches the traveler\\n4. Three recommended activities\\n\\nKeep all recommendations realistic and within the customer's budget.\"\n    }\n  ]\n}",
